# syntax=docker/dockerfile:1.4
FROM node:20-slim AS base
RUN corepack enable && corepack prepare pnpm@9 --activate

# Install system deps: openssl (Prisma), ffmpeg (audio), python3+pip (yt-dlp)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      openssl \
      ffmpeg \
      python3 \
      python3-pip \
      ca-certificates \
    && python3 -m pip install --break-system-packages --no-cache-dir -U "yt-dlp[default]" \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Non-root runtime user (uid 1001). Created in the shared base stage so both
# the build and production stages can reference it.
RUN useradd -r -u 1001 -m -d /home/ts6 ts6

WORKDIR /app

# Copy everything at once to avoid BuildKit ordering bug on Windows
FROM base AS build
COPY . .
RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @ts6/common run build
RUN pnpm --filter @ts6/backend exec prisma generate
RUN pnpm --filter @ts6/backend run build

# Production image
FROM base AS production
ENV NODE_ENV=production
# Run as the non-root ts6 user: HOME drives yt-dlp/prisma cache locations
ENV HOME=/home/ts6
ENV XDG_CONFIG_HOME=/home/ts6/.config
WORKDIR /app

# COPY --chown sets the owner while the layer is written, so no later chown has
# to touch /app. A chown over an existing layer forces overlayfs to copy every
# file up into the new layer (all 25k node_modules entries => +548 MB).
COPY --chown=ts6:ts6 --from=build /app/node_modules ./node_modules
COPY --chown=ts6:ts6 --from=build /app/package.json ./package.json
COPY --chown=ts6:ts6 --from=build /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --chown=ts6:ts6 --from=build /app/packages/common/dist ./packages/common/dist
COPY --chown=ts6:ts6 --from=build /app/packages/common/package.json ./packages/common/package.json
COPY --chown=ts6:ts6 --from=build /app/packages/backend/dist ./packages/backend/dist
COPY --chown=ts6:ts6 --from=build /app/packages/backend/generated ./packages/backend/generated
COPY --chown=ts6:ts6 --from=build /app/packages/backend/prisma ./packages/backend/prisma
COPY --chown=ts6:ts6 --from=build /app/packages/backend/package.json ./packages/backend/package.json
COPY --chown=ts6:ts6 --from=build /app/packages/backend/node_modules ./packages/backend/node_modules

WORKDIR /app/packages/backend
# yt-dlp config lives under the non-root user's home (uid 1001 => /home/ts6).
# Only dirs newly created in this layer need a chown here; /app files already
# carry the ts6 owner from the COPY --chown lines above. `data` is created
# relative to WORKDIR (/app/packages/backend) and backs the SQLite volume.
# COPY --chown only rewrites the files it copies, so the parent directories it
# implicitly creates stay root-owned; fix those four (non-recursive, so this
# stays a few kB instead of copying the whole tree up again).
RUN mkdir -p data /data/music && \
    mkdir -p /home/ts6/.config/yt-dlp && \
    echo "--js-runtimes node" > /home/ts6/.config/yt-dlp/config && \
    chown -R ts6:ts6 /home/ts6 /data/music data && \
    chown ts6:ts6 /app /app/packages /app/packages/common /app/packages/backend
USER ts6

EXPOSE 3001
ENV SIDECAR_URL=http://ts6-sidecar:9800
CMD ["sh", "-c", "npx prisma db push --skip-generate && npx prisma db seed || true && node dist/index.js"]
