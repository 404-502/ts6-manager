# syntax=docker/dockerfile:1.4
FROM node:20-slim AS base
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# Copy everything at once to avoid BuildKit ordering bug on Windows
FROM base AS build
COPY . .
RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @ts6/common run build
RUN pnpm --filter @ts6/frontend run build

# Production: serve with nginx
FROM nginx:alpine AS production

COPY --from=build /app/packages/frontend/dist /usr/share/nginx/html

# Nginx config for SPA routing + API proxy.
# Security headers are driven by map variables keyed on $request_uri instead of
# per-location add_header: the /widget/ SPA route is served by the `location /`
# try_files fallback (nginx internally redirects to /index.html and rewrites
# $uri), and a location-level add_header would be lost on that path. $request_uri
# keeps the original URI, so the embeddable CSP still applies to /widget/*.
RUN printf 'map $request_uri $ts6_csp {\n\
    default "default-src '"'"'self'"'"'; script-src '"'"'self'"'"'; style-src '"'"'self'"'"' '"'"'unsafe-inline'"'"'; img-src '"'"'self'"'"' data: blob:; media-src '"'"'self'"'"' blob:; connect-src '"'"'self'"'"' ws: wss:; object-src '"'"'none'"'"'; base-uri '"'"'self'"'"'; form-action '"'"'self'"'"'; frame-ancestors '"'"'self'"'"'";\n\
    ~^/widget/ "default-src '"'"'self'"'"'; script-src '"'"'self'"'"'; style-src '"'"'self'"'"' '"'"'unsafe-inline'"'"'; img-src '"'"'self'"'"' data: blob:; media-src '"'"'self'"'"' blob:; connect-src '"'"'self'"'"' ws: wss:; object-src '"'"'none'"'"'; base-uri '"'"'self'"'"'; form-action '"'"'self'"'"'; frame-ancestors *";\n\
}\n\
server {\n\
    listen 80;\n\
    server_name _;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    client_max_body_size 150m;\n\
\n\
    add_header X-Content-Type-Options nosniff always;\n\
    add_header Referrer-Policy strict-origin-when-cross-origin always;\n\
    add_header Content-Security-Policy $ts6_csp always;\n\
\n\
    location /api {\n\
        proxy_pass http://backend:3001;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Upgrade $http_upgrade;\n\
        proxy_set_header Connection "upgrade";\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $remote_addr;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
    }\n\
\n\
    location /ws {\n\
        proxy_pass http://backend:3001;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Upgrade $http_upgrade;\n\
        proxy_set_header Connection "upgrade";\n\
        proxy_set_header Host $host;\n\
    }\n\
\n\
    location /widget/ {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    gzip on;\n\
    gzip_types text/plain text/css application/json application/javascript text/xml;\n\
}\n' > /etc/nginx/conf.d/default.conf

# Run as the unprivileged nginx user. The official image starts as root and lets
# the master process drop privileges; here the master itself is non-root, so the
# paths it writes at startup (pid file, cache, logs, generated conf) must be
# owned by nginx beforehand. Binding port 80 is still allowed because containers
# default to net.ipv4.ip_unprivileged_port_start=0.
RUN sed -i 's|^user  *nginx;|# user directive dropped: master runs as nginx|' /etc/nginx/nginx.conf && \
    chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown nginx:nginx /var/run/nginx.pid
USER nginx

EXPOSE 80
